{
  "name": "catcut",
  "version": "0.5.1",
  "description": "CatCut — headless video editing MCP: After Effects (no UI) + aerender + ffmpeg, FCP7 XML for Premiere",
  "type": "module",
  "license": "MIT",
  "bin": {
    "catcut": "./dist/mcp/cli.js",
    "editmcp": "./dist/mcp/cli.js"
  },
  "main": "./dist/mcp/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/mcp/server.ts",
    "doctor": "tsx src/mcp/cli.ts doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "execa": "^9.5.2",
    "fast-xml-parser": "^5.0.9",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
